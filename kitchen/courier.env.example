# stack-courier config for the Sotto kitchen (example; nothing is running).
# Run from an ormus-stack checkout:  python3 scripts/stack-courier.py --init  (first run records, sends nothing)
GH_REPO=HermeticOrmus/Sotto
MENU_BRANCH=ormus
STACK_COURIER_KITCHEN=/path/to/HermeticOrmus-Sotto-clone        # a clone on ormus that holds pantry/
STACK_COURIER_STATE=$HOME/.local/state/stack-courier/sotto/seen.json
STACK_COURIER_GROUP=<Sotto kitchen Grok Bot group id>             # Diego to create
STACK_COURIER_SENDER=<Grok Bot sender command>                    # same sender the harness courier uses
STACK_COURIER_SEATS='{"plate":"Sotto Stack Kitchen","ship":"Sotto Desk","verify":"Sotto Stack Kitchen","verify_how":"verify-sotto skill + kitchen/FEATURE_MAP.md stations","proof":"Sotto Stack Kitchen","garden":"Sotto Stack Kitchen","law":"kitchen/LAW.md"}'
# STACK_COURIER_RESTOCK_PREFIX=pantry/   (default)
